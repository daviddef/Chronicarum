# Row-wise catalogue: 39 MB, and fully derivable from the columnar file that ships.
# Committing both would add ~68 MB per import commit to store the same data twice.
# Rebuild it before running an import:  python3 scripts/build_columnar.py --expand
Chronicarum/Resources/bulk_sites.json

# Cached raw Overpass responses for the trail import (per region, large). Regenerated on
# demand; trails.json — the small columnar output — is what ships and is committed.
scripts/.trails_raw_cache.json
scripts/.trails_cache_*.json

# Cached Overpass response for the family import.
scripts/.family_cache.json
